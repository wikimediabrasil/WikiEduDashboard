.revision-feedback-item
  margin-bottom: 8px

  p
    margin: 0
    line-height: 1.2

.revision-feedback-item__header
  display: flex
  align-items: center
  justify-content: space-between

.revision-feedback-item__author,
.revision-feedback-item__date
  color: #555

.revision-feedback-item__author
  font-size: 0.875em
  font-weight: bold

.revision-feedback-item__date
  font-size: 0.8em

.revision-feedback-item__comment
  font-size: 1.125em
  font-weight: normal

.revision-feedback-item__delete
  display: grid
  place-items: center
  flex-shrink: 0
  width: 24px
  height: 20px
  background: none
  border: 0
  border-radius: 4px
  color: #555
  padding: 0
  cursor: pointer

  &:hover,
  &:focus-visible
    background-color: #fce8e6
    color: #b32424
